package com.mycompany.parcial;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.Iterator;
import java.util.List;

public class Parcial {

    public static void main(String[] args) {

        List<String> inventario = new ArrayList<>();

        inventario.add("Programación Estructurada");
        inventario.add("Bases de datos");
        inventario.add("Redes de Computadores");
        inventario.add("Sistemas Operativos");

        String[] proveedor = {
            "Piloto de IoT",
            "Inteligencia Artificial",
            "Piloto de filosofía",
            "Seguridad Informática"
        };

        inventario.addAll(Arrays.asList(proveedor));

        System.out.println("LISTA CONSOLIDADA ANTES DE DEPURAR");
        System.out.println("Total de materias: " + inventario.size());

        for (String materia : inventario) {
            System.out.println("-" + materia);
        }

        Iterator<String> iterador = inventario.iterator();

        while (iterador.hasNext()) {
            String materia = iterador.next();

            if (materia.startsWith("Piloto")) {
                iterador.remove();
            }
        }

        System.out.println("\nLISTA DESPUÉS DE ELIMINAR LAS QUE EMPIEZAN CON \"Piloto\"");
        System.out.println("Total de materias: " + inventario.size());

        for (String materia : inventario) {
            System.out.println("-" + materia);
        }
    }
}
